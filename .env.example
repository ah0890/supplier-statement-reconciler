# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
# None of these values are required to run the application with CSV/XLSX/PDF files.

# --- Application -------------------------------------------------------------
# Where the SQLite database, uploads and logs are stored (relative to project root or absolute).
SSR_DATA_DIR=data
# Optional explicit SQLAlchemy URL. Defaults to sqlite:///<SSR_DATA_DIR>/reconciler.db
# SSR_DATABASE_URL=sqlite:///data/reconciler.db
# Maximum accepted upload size in megabytes.
SSR_MAX_UPLOAD_MB=25
# DEBUG, INFO, WARNING or ERROR
SSR_LOG_LEVEL=INFO

# --- Reconciliation defaults (can also be changed in the Settings page) --------
SSR_DEFAULT_AMOUNT_TOLERANCE=0.01
SSR_DEFAULT_DATE_TOLERANCE_DAYS=3
SSR_FUZZY_MATCH_THRESHOLD=80

# --- Xero (future integration - not required for the MVP) ----------------------
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=

# --- QuickBooks Online (future integration - not required for the MVP) ---------
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
